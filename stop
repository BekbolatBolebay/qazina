#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

if [ -f .data/qazina.pid ]; then
  pid=$(cat .data/qazina.pid)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" || true
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" || true
    fi
  fi
  : > .data/qazina.pid
fi

echo "QAZINA тоқтатылды."

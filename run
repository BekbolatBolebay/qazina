#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

PORT="${PORT:-3000}"
foreground=false
open_browser=false
force_build=false

for opt in "$@"; do
  case "$opt" in
    --foreground) foreground=true ;;
    --open) open_browser=true ;;
    --build) force_build=true ;;
    *) echo "Белгісіз параметр: $opt" >&2; exit 2 ;;
  esac
done

export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
if ! command -v npm >/dev/null 2>&1; then
  node_bin=$(find "${NVM_DIR:-$HOME/.nvm}/versions/node" -mindepth 2 -maxdepth 2 -type d -name bin 2>/dev/null | sort -V | tail -n 1 || true)
  if [ -n "$node_bin" ]; then export PATH="$node_bin:$PATH"; fi
fi

mkdir -p .data

if [ ! -f .env.local ] && [ -f .env.example ]; then
  cp .env.example .env.local
fi

if [ -f .env.local ]; then
  set -a
  # shellcheck disable=SC1091
  source .env.local
  set +a
fi

if [ -s .data/qazina.pid ]; then
  pid=$(cat .data/qazina.pid)
  if kill -0 "$pid" 2>/dev/null && curl --connect-timeout 1 --max-time 2 -fsS "http://127.0.0.1:$PORT/api/books" >/dev/null 2>&1; then
    echo "QAZINA қазірдің өзінде қосулы: http://localhost:$PORT"
    exit 0
  fi
fi

if [ ! -d node_modules ]; then
  echo "Тәуелділіктер орнатылуда..."
  npm ci
fi

if $force_build || [ ! -f .next/BUILD_ID ]; then
  echo "QAZINA жиналуда (npm run build)..."
  npm run build
fi

if $foreground; then
  echo $$ > .data/qazina.pid
  exec npx next start -H 0.0.0.0 -p "$PORT"
fi

setsid nohup npx next start -H 0.0.0.0 -p "$PORT" > .data/qazina.log 2>&1 < /dev/null &
echo $! > .data/qazina.pid

for _ in {1..30}; do
  if curl --connect-timeout 1 --max-time 2 -fsS "http://127.0.0.1:$PORT/api/books" >/dev/null 2>&1; then
    echo "QAZINA дайын: http://localhost:$PORT (http://127.0.0.1:$PORT)"
    if $open_browser; then
      xdg-open "http://localhost:$PORT" >/dev/null 2>&1 || true
    fi
    exit 0
  fi
  sleep 1
done

echo "Сервер дер кезінде жауап бермеді. Лог: .data/qazina.log" >&2
tail -n 30 .data/qazina.log >&2 || true
exit 1

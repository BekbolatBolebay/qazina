# QAZINA — Alem Plus & OpenAI-compatible Cloud API Configuration
# Copy to .env.local and provide your keys. Without keys, QAZINA runs in Offline MVP mode.

LLM_PROVIDER=alem
LLM_API_URL=https://llm.alem.ai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=qwen3-8

ALEM_KAZLLM_KEY=
ALEM_QWEN_KEY=
ALEM_GEMMA4_KEY=
ALEM_OCR_KEY=

ALEM_EMBED_URL=https://llm.alem.ai/v1/embeddings
ALEM_EMBED_KEY=
ALEM_EMBED_MODEL=text-1024

ALEM_RERANK_URL=https://llm.alem.ai/v1/rerank
ALEM_RERANK_KEY=
ALEM_RERANK_MODEL=reranker

ALEM_STT_URL=https://llm.alem.ai/v1/audio/transcriptions
ALEM_STT_KK_KEY=
ALEM_STT_KEY=

ALEM_IMAGE_URL=https://llm.alem.ai/v1/images/generations
ALEM_IMAGE_KEY=
ALEM_IMAGE_MODEL=text-to-image

DATABASE_URL=
SUPABASE_URL=
MINIO_S3_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

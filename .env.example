# Copy to .env; replace passwords before any deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://mood:replace-with-a-long-random-password@127.0.0.1:5438/mood?sslmode=disable
APP_ORIGIN=http://localhost:8088
ADDR=127.0.0.1:8088
COOKIE_SECURE=false
SEED_DATA=true
# LLM для подбора книг по эмоции (OpenAI-совместимое API)
# LLM для подбора книг по эмоции (OpenAI-совместимое API).
LLM_API_URL=https://llm.alem.ai/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-oss
